# ==============================================================================
# SPORTS BETTING & AGENT EXCHANGE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Persistence (PostgreSQL 16)
POSTGRES_USER=exchange_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_POSTGRES_PWD
POSTGRES_DB=sports_exchange
POSTGRES_PORT=5432
DATABASE_URL=postgresql://exchange_admin:CHANGE_ME_IN_PRODUCTION_SECURE_POSTGRES_PWD@postgres:5432/sports_exchange

# In-Memory Cache & Pub/Sub (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_REDIS_PWD
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION_SECURE_REDIS_PWD@redis:6379

# Backend Application Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=GENERATE_A_64_CHAR_RANDOM_HEX_STRING_FOR_JWT_SECURITY
JWT_EXPIRES_IN=7d
COMMISSION_RATE=0.02
SIMULATOR_ENABLED=true

# Port Bindings for Reverse Proxy / Load Balancer
BACKEND_PORT=5000
AGENT_PORTAL_PORT=3000
PLAYER_PORTAL_PORT=3001

# External Feed Configuration (Betfair / Betradar)
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=
BETRADAR_API_KEY=
