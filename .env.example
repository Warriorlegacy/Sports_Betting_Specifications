# Database Configuration (Neon PostgreSQL 16 or local)
DATABASE_URL=postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=exchange_admin
POSTGRES_PASSWORD=exchange_secure_password_2026
POSTGRES_DB=sports_exchange
POSTGRES_PORT=5432

# Redis Configuration (Upstash Serverless Redis 7 or local)
REDIS_URL=rediss://default:token@region.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Backend Application Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secure_sports_exchange_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
COMMISSION_RATE=0.02
SIMULATOR_ENABLED=true

# Inactivity Sleep Configuration (1 Minute Threshold)
INACTIVITY_SLEEP_TIMEOUT_MS=60000
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_service_id

# Frontend Ports
VITE_API_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
